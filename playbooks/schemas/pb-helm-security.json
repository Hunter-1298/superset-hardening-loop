{
  "$id": "https://hardening-loop/schemas/pb-helm-security.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "pr_opened"
          }
        }
      },
      "then": {
        "properties": {
          "pr_url": {
            "type": "string"
          }
        },
        "required": [
          "pr_url"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "properties": {
          "blocked_reason": {
            "minLength": 10,
            "type": "string"
          }
        },
        "required": [
          "blocked_reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "no_change_needed"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "minLength": 10,
            "type": "string"
          }
        },
        "required": [
          "reason",
          "evidence_urls"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "pr_opened"
          }
        }
      },
      "then": {
        "properties": {
          "values_changed": {
            "minItems": 1
          }
        },
        "required": [
          "values_changed",
          "helm_lint"
        ]
      }
    }
  ],
  "properties": {
    "base_branch": {
      "const": "main",
      "type": "string"
    },
    "blocked_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_urls": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "findings_addressed": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "findings_not_addressed": {
      "items": {
        "properties": {
          "id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "reason"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "helm_lint": {
      "type": [
        "string",
        "null"
      ]
    },
    "helm_template_diff_attachment": {
      "type": [
        "string",
        "null"
      ]
    },
    "outcome": {
      "enum": [
        "pr_opened",
        "blocked",
        "no_change_needed"
      ],
      "type": "string"
    },
    "pr_url": {
      "pattern": "^https://github.com/[^/]+/[^/]+/pull/[0-9]+$",
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "tests_run": {
      "items": {
        "properties": {
          "command": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          },
          "log_attachment": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "command",
          "exit_code"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "values_changed": {
      "items": {
        "properties": {
          "from": {},
          "path": {
            "type": "string"
          },
          "to": {}
        },
        "required": [
          "path",
          "from",
          "to"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "outcome",
    "base_branch",
    "findings_addressed",
    "findings_not_addressed"
  ],
  "title": "pb-helm-security structured output",
  "type": "object"
}
