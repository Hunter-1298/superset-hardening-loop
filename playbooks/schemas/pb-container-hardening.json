{
  "$id": "https://hardening-loop/schemas/pb-container-hardening.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "pr_opened"
          }
        }
      },
      "then": {
        "properties": {
          "pr_url": {
            "type": "string"
          }
        },
        "required": [
          "pr_url"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "properties": {
          "blocked_reason": {
            "minLength": 10,
            "type": "string"
          }
        },
        "required": [
          "blocked_reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "no_change_needed"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "minLength": 10,
            "type": "string"
          }
        },
        "required": [
          "reason",
          "evidence_urls"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "pr_opened"
          }
        }
      },
      "then": {
        "properties": {
          "changes": {
            "minItems": 1
          }
        },
        "required": [
          "changes",
          "lean_smoke_local"
        ]
      }
    }
  ],
  "properties": {
    "base_branch": {
      "const": "main",
      "type": "string"
    },
    "blocked_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "changes": {
      "items": {
        "properties": {
          "detail": {
            "type": "string"
          },
          "type": {
            "enum": [
              "base_image",
              "package_removal",
              "user",
              "permissions",
              "pin"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "detail"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "evidence_urls": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "findings_addressed": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "findings_not_addressed": {
      "items": {
        "properties": {
          "id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "reason"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "image_size_before_after": {
      "properties": {
        "after": {
          "type": "integer"
        },
        "before": {
          "type": "integer"
        }
      },
      "type": [
        "object",
        "null"
      ]
    },
    "lean_smoke_local": {
      "type": "boolean"
    },
    "outcome": {
      "enum": [
        "pr_opened",
        "blocked",
        "no_change_needed"
      ],
      "type": "string"
    },
    "pr_url": {
      "pattern": "^https://github.com/[^/]+/[^/]+/pull/[0-9]+$",
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "tests_run": {
      "items": {
        "properties": {
          "command": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          },
          "log_attachment": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "command",
          "exit_code"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "outcome",
    "base_branch",
    "findings_addressed",
    "findings_not_addressed"
  ],
  "title": "pb-container-hardening structured output",
  "type": "object"
}
