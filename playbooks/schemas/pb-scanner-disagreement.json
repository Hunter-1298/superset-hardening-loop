{
  "$id": "https://hardening-loop/schemas/pb-scanner-disagreement.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "pr_opened"
          }
        }
      },
      "then": {
        "properties": {
          "pr_url": {
            "type": "string"
          }
        },
        "required": [
          "pr_url"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "properties": {
          "blocked_reason": {
            "minLength": 10,
            "type": "string"
          }
        },
        "required": [
          "blocked_reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "no_change_needed"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "minLength": 10,
            "type": "string"
          }
        },
        "required": [
          "reason",
          "evidence_urls"
        ]
      }
    },
    {
      "properties": {
        "outcome": {
          "enum": [
            "no_change_needed",
            "blocked"
          ]
        }
      }
    }
  ],
  "properties": {
    "base_branch": {
      "const": "main",
      "type": "string"
    },
    "blocked_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "items": {
        "properties": {
          "reasoning": {
            "type": "string"
          },
          "record": {
            "type": "object"
          },
          "scanner": {
            "enum": [
              "trivy",
              "grype"
            ],
            "type": "string"
          }
        },
        "required": [
          "scanner",
          "record",
          "reasoning"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "evidence_urls": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "findings_addressed": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "findings_not_addressed": {
      "items": {
        "properties": {
          "id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "reason"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "outcome": {
      "enum": [
        "pr_opened",
        "blocked",
        "no_change_needed"
      ],
      "type": "string"
    },
    "pr_url": {
      "pattern": "^https://github.com/[^/]+/[^/]+/pull/[0-9]+$",
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "recommended_action": {
      "enum": [
        "upgrade",
        "vex",
        "none"
      ],
      "type": "string"
    },
    "tests_run": {
      "items": {
        "properties": {
          "command": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          },
          "log_attachment": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "command",
          "exit_code"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "verdict": {
      "enum": [
        "trivy_correct",
        "grype_correct",
        "both_partial",
        "undetermined"
      ],
      "type": "string"
    }
  },
  "required": [
    "outcome",
    "base_branch",
    "findings_addressed",
    "findings_not_addressed",
    "verdict",
    "evidence",
    "recommended_action"
  ],
  "title": "pb-scanner-disagreement structured output",
  "type": "object"
}
